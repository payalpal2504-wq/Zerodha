# Server Environment Configuration
PORT=5000
NODE_ENV=development
HOST=0.0.0.0

# Database Connection (MongoDB Atlas or Local MongoDB)
MONGODB_URI=mongodb://127.0.0.1:27017/zerodha_trading
AUTO_SEED=false

# Authentication
JWT_SECRET=zerodha_secure_jwt_secret_change_in_production_8899
JWT_EXPIRES_IN=7d

# Frontend CORS
FRONTEND_URL=http://localhost:5173

# SMS Provider Configuration ('mock' for dev test mode, 'fast2sms', or 'msg91')
SMS_PROVIDER=mock

# Fast2SMS Credentials (leave blank if using MSG91 or mock)
FAST2SMS_API_KEY=

# MSG91 Credentials (leave blank if using Fast2SMS or mock)
MSG91_AUTH_KEY=
MSG91_TEMPLATE_ID=
